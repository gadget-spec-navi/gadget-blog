---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_TITLE, CONTACT_FORM_ENDPOINT } from '../consts';

const topics = [
  { emoji: '📝', label: '記事の内容に関するご指摘・訂正のご依頼' },
  { emoji: '🔍', label: '比較してほしい製品・カテゴリーのリクエスト' },
  { emoji: '🤝', label: '製品提供・レビュー・タイアップのご相談' },
  { emoji: '©️', label: '掲載内容の権利（著作権・商標）に関するご連絡' },
];

const field =
  'mt-2 block w-full rounded-panel border border-hairline bg-white px-4 py-3 text-[17px] leading-[1.47] tracking-[-0.01em] text-ink transition-colors placeholder:text-ink-3 focus:border-blue focus:outline-2 focus:outline-offset-0 focus:outline-blue';
const label = 'block text-[14px] font-semibold tracking-[-0.01em] text-ink';
const required = 'ml-1 font-normal text-ink-3';
---

<PageLayout
  title="お問い合わせ"
  description={`${SITE_TITLE}へのご質問・ご指摘・製品リクエスト・掲載に関するご相談はこちらのフォームから承ります。`}
>
  <!-- 問い合わせ内容の例 -->
  <section class="not-prose rounded-tile bg-surface px-6 py-8 sm:px-10">
    <h2 class="text-[21px] leading-[1.19] font-semibold tracking-[-0.015em] text-ink sm:text-[24px]">
      こんなご連絡をお待ちしています
    </h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        topics.map((topic) => (
          <li class="flex items-start gap-3 text-[17px] leading-[1.47] tracking-[-0.01em] text-ink-2">
            <span class="text-[20px] leading-[1.2]" aria-hidden="true">
              {topic.emoji}
            </span>
            <span>{topic.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!--
    お問い合わせフォーム。
    静的サイトのため送信は外部サービス（SSGフォーム）に POST する。
    送信先は src/consts.ts の CONTACT_FORM_ENDPOINT で変更する。
  -->
  <section class="not-prose mt-14">
    <h2
      class="text-center text-[24px] leading-[1.16] font-semibold tracking-[-0.015em] text-ink sm:text-[28px]"
    >
      フォームから送る
    </h2>
    <p
      class="mx-auto mt-4 max-w-[560px] text-center text-[17px] leading-[1.47] tracking-[-0.01em] text-ink-2"
    >
      下記のフォームに入力して送信してください。内容を確認のうえ、ご記入のメールアドレス宛にご返信します。
    </p>

    <form action={CONTACT_FORM_ENDPOINT} method="POST" class="mx-auto mt-8 max-w-[560px]">
      <div>
        <label class={label} for="name">
          お名前<span class={required}>（必須）</span>
        </label>
        <input
          class={field}
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          placeholder="山田 太郎"
        />
      </div>

      <div class="mt-6">
        <label class={label} for="email">
          メールアドレス<span class={required}>（必須）</span>
        </label>
        <input
          class={field}
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
        />
        <p class="mt-2 text-[12px] leading-[1.33] text-ink-3">
          ご返信先です。お間違いがないかご確認ください。
        </p>
      </div>

      <div class="mt-6">
        <label class={label} for="subject">
          件名<span class={required}>（必須）</span>
        </label>
        <input
          class={field}
          id="subject"
          name="subject"
          type="text"
          required
          placeholder="記事の内容についてのご指摘"
        />
      </div>

      <div class="mt-6">
        <label class={label} for="message">
          お問い合わせ内容<span class={required}>（必須）</span>
        </label>
        <textarea
          class={field}
          id="message"
          name="message"
          rows="8"
          required
          placeholder="記事へのご指摘の場合は、該当ページのURLを添えていただけると助かります。"></textarea>
      </div>

      <p class="mt-6 text-[12px] leading-[1.33] text-ink-3">
        送信いただいた内容は、お問い合わせへの回答のみに利用します。取り扱いについては
        <a href="/privacy/" class="text-link hover:underline">プライバシーポリシー</a>
        をご確認ください。
      </p>

      <button
        type="submit"
        class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-blue px-[22px] py-[12px] text-[17px] leading-[1.17648] text-white transition-colors hover:bg-blue-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue sm:w-auto"
      >
        送信する
      </button>
    </form>
  </section>

  <!-- 注意事項 -->
  <section class="not-prose mt-14 border-t border-hairline pt-8">
    <h2 class="text-[17px] font-semibold tracking-[-0.015em] text-ink">ご連絡の前に</h2>
    <ul class="mt-4 space-y-3 text-[14px] leading-[1.43] text-ink-2">
      <li>
        ご返信までに数日いただく場合があります。内容によっては回答を差し控えることがありますので、あらかじめご了承ください。
      </li>
      <li>
        製品の購入手続き・配送・返品・故障に関するお問い合わせには対応できません。各販売サイトまたはメーカーへ直接ご連絡ください。
      </li>
      <li>
        掲載内容に誤りを見つけられた場合は、該当する記事のURLを添えてお知らせいただけると助かります。
      </li>
      <li>
        いただいた個人情報は
        <a href="/privacy/" class="text-link hover:underline">プライバシーポリシー</a>
        に従って取り扱います。
      </li>
    </ul>
  </section>
</PageLayout>
