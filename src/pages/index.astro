---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getPublishedPosts, getCategorySummaries } from '../utils/posts';

const posts = await getPublishedPosts();

// ピックアップ記事（featured 指定がなければ最新記事）
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post.id !== featured?.id);

// カテゴリー（記事数の多い順・0 件は除外）
const categories = await getCategorySummaries();
---

<BaseLayout title={`${SITE_TITLE} | スペックで選ぶガジェット比較サイト`} description={SITE_DESCRIPTION}>
  <!-- ヒーロー: Apple のプロダクトページ準拠（中央揃え・大見出し semibold・青のテキストリンク） -->
  <section class="bg-white">
    <div class="mx-auto max-w-[980px] px-4 py-16 text-center sm:py-24">
      <h1
        class="text-[40px] leading-[1.05] font-semibold tracking-[-0.015em] text-balance text-ink sm:text-[64px]"
      >
        スペックを、<br class="sm:hidden" />並べて選ぶ。
      </h1>
      <p
        class="mx-auto mt-4 max-w-[600px] text-[19px] leading-[1.38] tracking-[-0.01em] text-ink-2 sm:text-[21px]"
      >
        {SITE_DESCRIPTION}
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        <a
          href="#articles"
          class="inline-flex items-center justify-center rounded-full bg-blue px-[22px] py-[12px] text-[17px] leading-[1.17648] text-white transition-colors hover:bg-blue-hover"
        >
          比較記事を読む
        </a>
        <a href="#categories" class="a-link text-[17px] tracking-[-0.01em]">カテゴリーから探す</a>
      </div>
    </div>
  </section>

  <!-- ピックアップ: 全幅の大型タイル -->
  {
    featured && (
      <section class="bg-white pb-3">
        <div class="mx-auto max-w-[980px] px-4">
          <a
            href={`/blog/${featured.id}/`}
            class="group block overflow-hidden rounded-tile bg-surface px-6 py-14 text-center transition-transform duration-300 hover:-translate-y-1 sm:px-16 sm:py-20"
          >
            <p class="text-[12px] font-semibold tracking-[-0.01em] text-ink-2">今月のピックアップ</p>
            <p class="mt-6 text-[80px] leading-none transition-transform duration-300 group-hover:scale-110">
              <span aria-hidden="true">{featured.data.emoji}</span>
            </p>
            <div class="mt-8">
              <CategoryBadge category={featured.data.category} />
            </div>
            <h2 class="mx-auto mt-2 max-w-[720px] text-[28px] leading-[1.1] font-semibold tracking-[-0.015em] text-balance text-ink sm:text-[40px]">
              {featured.data.title}
            </h2>
            <p class="mx-auto mt-4 max-w-[600px] text-[17px] leading-[1.47] tracking-[-0.01em] text-ink-2 sm:text-[19px]">
              {featured.data.description}
            </p>
            <p class="mt-6 flex items-center justify-center gap-4 text-[17px]">
              <span class="text-link group-hover:underline">比較を見る &rsaquo;</span>
              <FormattedDate date={featured.data.pubDate} class="text-[14px] text-ink-3" />
            </p>
          </a>
        </div>
      </section>
    )
  }

  <!-- 記事一覧 -->
  <section id="articles" class="scroll-mt-16 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-[980px] px-4">
      <h2
        class="text-center text-[32px] leading-[1.09] font-semibold tracking-[-0.015em] text-ink sm:text-[40px]"
      >
        比較記事
      </h2>
      <p class="mt-3 text-center text-[17px] leading-[1.47] tracking-[-0.01em] text-ink-2">
        実測値とメーカー公称値を、同じ土俵で。
      </p>

      {
        rest.length > 0 ? (
          <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((post) => (
              <ArticleCard post={post} />
            ))}
          </div>
        ) : (
          <p class="mt-10 text-center text-[17px] text-ink-2">
            記事はまだありません。<code class="text-ink">src/content/blog/</code>{' '}
            に Markdown を追加してください。
          </p>
        )
      }
    </div>
  </section>

  <!-- カテゴリー -->
  <section id="categories" class="scroll-mt-16 bg-surface py-16 sm:py-20">
    <div class="mx-auto max-w-[980px] px-4 text-center">
      <h2
        class="text-[32px] leading-[1.09] font-semibold tracking-[-0.015em] text-ink sm:text-[40px]"
      >
        カテゴリーから探す
      </h2>
      <p class="mt-3 text-[17px] leading-[1.47] tracking-[-0.01em] text-ink-2">
        ジャンルを選ぶと、そのカテゴリーの比較記事だけを表示します。
      </p>
      <ul class="mt-8 flex flex-wrap justify-center gap-3">
        {
          categories.map((category) => (
            <li>
              <a
                href={category.href}
                class="inline-flex items-center gap-2 rounded-full border border-hairline bg-white px-4 py-2 text-[14px] tracking-[-0.01em] transition-colors hover:bg-surface"
              >
                <span aria-hidden="true">{category.emoji}</span>
                <span class="font-semibold" style={`color:${category.color}`}>
                  {category.label}
                </span>
                <span class="text-ink-3">{category.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-10">
        <a href="/category/" class="a-link text-[17px] tracking-[-0.01em]">
          カテゴリー一覧を見る
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
