---
import { CATEGORY_COLORS, DEFAULT_CATEGORY_COLOR } from '../consts';

interface Props {
  category: string;
  /** 'eyebrow' = Apple のマーケティングページ風の色文字 / 'chip' = 枠線付きチップ */
  variant?: 'eyebrow' | 'chip';
  class?: string;
}

const { category, variant = 'eyebrow', class: className = '' } = Astro.props;
const color = CATEGORY_COLORS[category] ?? DEFAULT_CATEGORY_COLOR;
---

{
  variant === 'eyebrow' ? (
    <span
      class={`text-[12px] font-semibold tracking-[-0.01em] ${className}`}
      style={`color:${color}`}
    >
      {category}
    </span>
  ) : (
    <span
      class={`inline-flex items-center gap-1.5 rounded-full border border-hairline px-3 py-1.5 text-[14px] text-ink transition-colors hover:bg-surface ${className}`}
    >
      <span
        class="h-1.5 w-1.5 rounded-full"
        style={`background-color:${color}`}
        aria-hidden="true"
      />
      {category}
    </span>
  )
}
